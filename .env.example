# Database Connection (Used by Drizzle)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Signs sessions and cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="[YOUR-SECRET]"

# Who may sign in: Google emails, comma separated. Empty means nobody.
AUTH_ALLOWED_EMAILS="[OWNER-EMAIL],[DEVELOPER-EMAIL]"

# Google OAuth Credentials (sign-in, and Calendar and Contacts access)
# Authorized redirect URI in Google Console: [SITE-URL]/api/auth/callback/google
GOOGLE_CLIENT_ID="[YOUR-GOOGLE-CLIENT-ID]"
GOOGLE_CLIENT_SECRET="[YOUR-GOOGLE-CLIENT-SECRET]"

# Where "Email developer" sends error reports (optional; without it the
# error screens and toasts only offer "Copy report")
NEXT_PUBLIC_SUPPORT_EMAIL="[DEVELOPER-EMAIL]"

# Application URL (REQUIRED for OAuth Redirects)
# Set to your production URL on deployment platforms (e.g., https://jnaninyoga.up.railway.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
