# Database Connection (Used by Drizzle)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Signs sessions and cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="[YOUR-SECRET]"

# Who may sign in: Google emails, comma separated. Empty means nobody.
AUTH_ALLOWED_EMAILS="[OWNER-EMAIL],[DEVELOPER-EMAIL]"

# Google OAuth Credentials (sign-in, and Calendar and Contacts access)
# Authorized redirect URI in Google Console: [SITE-URL]/api/auth/callback/google
GOOGLE_CLIENT_ID="[YOUR-GOOGLE-CLIENT-ID]"
GOOGLE_CLIENT_SECRET="[YOUR-GOOGLE-CLIENT-SECRET]"

# Where "Email developer" sends error reports (optional; without it the
# error screens and toasts only offer "Copy report")
NEXT_PUBLIC_SUPPORT_EMAIL="[DEVELOPER-EMAIL]"

# Application URL (REQUIRED for OAuth Redirects)
# Set to your production URL on deployment platforms (e.g., https://jnaninyoga.up.railway.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Website bookings (POST /api/public/v1/requests from jnaninyoga.com)
# The website's origins, comma separated: only they may send the booking form.
WEBSITE_ORIGINS=https://jnaninyoga.com,https://www.jnaninyoga.com,https://jnaninyoga.pages.dev
# Secret key of the form's Cloudflare Turnstile widget. Without it the endpoint
# answers 503 and the website offers WhatsApp instead.
TURNSTILE_SECRET=

# The email to contact@ for each booking, sent through the studio's mailbox (Mailhostbox SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: where it goes (default contact@jnaninyoga.com)
REQUESTS_EMAIL_TO=

# Phone notifications for each booking. Generate a pair once with:
# node --input-type=module -e "import { generateVAPIDKeys } from 'web-push'; console.log(generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: who the push services can contact (default mailto:contact@jnaninyoga.com)
VAPID_SUBJECT=

# The website reads class times and cards from GET /api/public/v1/site while it
# builds. Saving them asks Cloudflare Pages to rebuild it through this deploy
# hook (Pages project > Settings > Builds > Deploy hooks). Without it, saves
# still work and the site updates on its next build.
SITE_DEPLOY_HOOK_URL=
# Vercel's daily cron calls /api/cron/rebuild-website with this as a bearer token.
CRON_SECRET=
